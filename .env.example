# Reference list of environment variables. The app reads real environment variables
# only; it does not load a .env file. To use this file in a shell:
#   cp .env.example .env && set -a && . ./.env && set +a
# Never commit real values.
HOOKRELAY_DB_PATH=hookrelay.db
# Total attempts per delivery, first try included (1-20).
HOOKRELAY_MAX_ATTEMPTS=3
HOOKRELAY_MAX_PAYLOAD_BYTES=65536
# Comma-separated hosts allowed despite the private-address block. Test use only.
HOOKRELAY_TEST_ALLOWED_HOSTS=
# Seconds before a delivery attempt times out (0 < value <= 120).
HOOKRELAY_DELIVERY_TIMEOUT=10
# Send deliveries in the background when an event is created.
HOOKRELAY_AUTO_DELIVER=true
# Retry backoff: base * 2^(n-1), capped. Interval is how often due retries are swept (0 disables).
HOOKRELAY_RETRY_BASE_SECONDS=30
HOOKRELAY_RETRY_MAX_DELAY_SECONDS=3600
HOOKRELAY_RETRY_INTERVAL_SECONDS=15
